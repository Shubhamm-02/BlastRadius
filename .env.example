# Copy this file to .env.local and fill in your values.

# --- Required: Neo4j AuraDB (from the "Connect" tab of your instance) -------
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-generated-password
# Then run once: npm run db:migrate

# --- Optional: AI explanations ---------------------------------------------
# Enables the Sarvam AI blast-radius explanation. Without it, a deterministic
# summary is shown instead, so the app still works.
SARVAM_API_KEY=
# Override the Sarvam model (defaults to sarvam-105b).
# SARVAM_MODEL=sarvam-105b

# --- Optional: GitHub ingest -----------------------------------------------
# Raises GitHub rate limits / allows private repos during ingest.
GITHUB_TOKEN=
# Reject repos larger than this (GitHub-reported size, MB). Default 250.
# GITHUB_MAX_REPO_MB=250

# --- Housekeeping ----------------------------------------------------------
# Projects older than this many days are deleted by /api/cron/cleanup.
# PROJECT_TTL_DAYS=7
# Bearer secret for /api/cron/cleanup. Vercel Cron sends it automatically when
# set as a project env var. The route refuses all calls if this is unset.
CRON_SECRET=

# Password for the /stats dashboard (HTTP basic auth, any username).
# /stats is disabled if this is unset.
STATS_PASSWORD=

# --- Optional: per-IP rate limits (requests per minute, per server instance)
# RATE_LIMIT_INGEST_PER_MIN=5
# RATE_LIMIT_IMPACT_PER_MIN=60
# RATE_LIMIT_EXPLAIN_PER_MIN=20
