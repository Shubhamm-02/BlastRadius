# Copy to .env.local and fill in.

# Neo4j AuraDB credentials, from the "Connect" tab of your instance. Required.
# After setting them, run once: npm run db:migrate
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-generated-password

# Model-written summaries. Without a key, a deterministic summary is shown.
SARVAM_API_KEY=
# SARVAM_MODEL=sarvam-105b

# GitHub ingest. A token raises rate limits and allows private repos.
GITHUB_TOKEN=
# Reject repos over this GitHub-reported size in MB (includes git history).
# GITHUB_MAX_REPO_MB=250

# Projects older than this many days are deleted by /api/cron/cleanup.
# PROJECT_TTL_DAYS=7
# Bearer secret for /api/cron/cleanup. Vercel Cron sends it when it is set as a
# project env var. The route refuses all calls while it is unset.
CRON_SECRET=

# Basic-auth password for /stats (any username). /stats is disabled while unset.
STATS_PASSWORD=

# Per-IP rate limits in requests per minute. Counted per server instance.
# RATE_LIMIT_INGEST_PER_MIN=5
# RATE_LIMIT_IMPACT_PER_MIN=60
# RATE_LIMIT_EXPLAIN_PER_MIN=20
